{
  "name": "revprod-landing-page",
  "description": "Development tooling for the revprod landing page: formatting with Prettier, table of contents with doctoc.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "doctoc": "doctoc --github --notitle --dryrun README.md",
    "doctoc:write": "doctoc --github --notitle README.md && prettier --write README.md",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "doctoc": "2.5.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": "^26"
  }
}
